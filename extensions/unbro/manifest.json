{
  "manifest_version": 3,
  "name": "Unbro",
  "version": "1.0.0",
  "description": "Hides the \", bro\" that sites running bro-mode add to their pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["unbro.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
