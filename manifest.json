{
  "manifest_version": 3,
  "name": "Bro",
  "version": "1.0.0",
  "description": "Ends every full sentence on every page with \", bro.\"",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bro.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
