{
  "name": "browserify-bro",
  "version": "1.1.0",
  "private": true,
  "description": "Bro everywhere: the bro-mode npm package plus the Bro and Unbro Chrome extensions.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "test": "npm test --workspaces && node --test \"tests/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "store-assets": "node scripts/store-assets.js"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
